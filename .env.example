# sencai-sdk je čistá knihovna — nečte ENV proměnné sama za běhu (base URL a token se předávají
# do Configuration(), viz README.md). Tento soubor je konvence pro konzumující kód (příklady,
# integrační testy), ne pro balíček samotný.

# Base URL Sencai Platform API (bez koncového lomítka), např.:
#   SENCAI_API_BASE_URL=http://api.sencai.localhost/api/v1   (lokální orchestrace)
#   SENCAI_API_BASE_URL=https://api.sencai.space/api/v1      (produkce)
SENCAI_API_BASE_URL=http://api.sencai.localhost/api/v1

# Bearer JWT (Keycloak access token) pro autentizovaná volání v příkladech/testech.
SENCAI_API_TOKEN=
